{
  "name": "voipsuite",
  "version": "0.95.0",
  "main": "app.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "nodemon -x 'node --env-file=.env' app.ts",
    "build": "npm run build -w frontend",
    "start": "NODE_ENV=production node --env-file=.env app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "oxlint": "oxlint --ignore-pattern 'frontend/**'"
  },
  "dependencies": {
    "@nullix/zod-mongoose": "^2.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "h3": "2.0.1-rc.22",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "moment": "^2.30.1",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "nodemailer-openpgp": "^2.2.1",
    "openpgp": "^6.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "telnyx": "^6.73.0",
    "twilio": "^6.0.2",
    "validatorjs": "^3.22.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/validatorjs": "^3.15.5",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
