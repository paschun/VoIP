{
  "include": ["*.ts", "app/**/*", "shared/**/*", "test/**/*"],
  "exclude": ["node_modules", "frontend", "uploads", "dist"],

  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"],
    "module": "nodenext",
    "resolveJsonModule": true,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    // Let imports keep their real `.ts` extension (`import './x.ts'`) — that's the path Node actually resolves at runtime.
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noEmit": true
  }
}
