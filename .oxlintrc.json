{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "promise", "import", "vitest"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error", // enabled by default
    // "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": "error", // pedantic
    // `Number.isNaN`/`Number.isFinite` don't coerce their argument.
    "no-restricted-globals": [
      "error",
      { "name": "isNaN", "message": "Use Number.isNaN instead." },
      { "name": "isFinite", "message": "Use Number.isFinite instead." }
    ], // restriction
    "no-shadow": "error", // suspicious
    "import/no-cycle": "warn", // restriction
    "no-redeclare": "error", // pedantic
    "no-param-reassign": "error", // restriction
    // oxlint-tsgolint doesn't seem to automatically make error in catch as unknown, like tsc does with `useUnknownInCatchVariables`
    "typescript/use-unknown-in-catch-callback-variable": "error", // restriction
    "vitest/no-disabled-tests": "warn", // lower to warn
    "typescript/no-namespace": ["error", { "allowDeclarations": true }], // allow namespaces in module augmentation, for contact schema

    "typescript/consistent-type-assertions": ["warn", { "assertionStyle": "never" }], // style
    "typescript/no-explicit-any": "error", // restriction
    "typescript/no-non-null-assertion": "error", // restriction

    // migrated from eslint:
    "no-var": "error", // restriction
    "no-array-constructor": "error", // pedantic
    "prefer-const": "error", // style
    "prefer-rest-params": "error", // style
    "prefer-spread": "error", // style
    "typescript/ban-ts-comment": "error", // pedantic
    "typescript/no-empty-object-type": "error", // restriction
    "typescript/no-import-type-side-effects": "error", // restriction
    "typescript/no-misused-promises": "error", // pedantic
    "typescript/no-require-imports": "error", // restriction
    "typescript/no-unnecessary-type-assertion": "error", // suspicious
    "typescript/no-unnecessary-type-constraint": "error", // suspicious
    "typescript/no-unsafe-argument": "error", // pedantic
    "typescript/no-unsafe-assignment": "error", // pedantic
    "typescript/no-unsafe-call": "error", // pedantic
    "typescript/no-unsafe-enum-comparison": "error", // suspicious
    "typescript/no-unsafe-function-type": "error", // pedantic
    "typescript/no-unsafe-member-access": "error", // pedantic
    "typescript/no-unsafe-return": "error", // pedantic
    "typescript/only-throw-error": "error", // pedantic
    "typescript/prefer-optional-chain": "error", // nursery
    "typescript/prefer-promise-reject-errors": "error", // pedantic
    "typescript/require-await": "error", // pedantic
    "typescript/restrict-plus-operands": "error", // pedantic

  }
}
