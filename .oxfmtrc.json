{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 136,
  "bracketSameLine": false,
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      { "groupName": "vitest", "elementNamePattern": ["vitest"] },
      { "groupName": "hono", "elementNamePattern": ["hono"] },
      { "groupName": "hono-subpath", "elementNamePattern": ["hono/**", "@hono/**"] },
      { "groupName": "mongoose", "elementNamePattern": ["mongoose", "mongoose/**"] }
    ],
    "groups": [
      "builtin",
      "vitest",
      "hono",
      "hono-subpath",
      "mongoose",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "ignorePatterns": []
}
